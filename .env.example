NODE_ENV=development
LOG_LEVEL=info
PORT=3000
REPOSITORY=postgres
DATABASE_URL=postgres://cloudworx:cloudworx@localhost:55432/cloudworx
REDIS_URL=redis://localhost:56379

JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
JWT_ISSUER=cloudworx-mock-idp
JWT_AUDIENCE=cloudworx-integration-api

SIZING_URL=http://localhost:4001
CATALOGUE_URL=http://localhost:4002
PRICING_URL=http://localhost:4003
SIZING_API_VERSION=v1

SIDEBAR_BUDGET_MS=1000
SECTION_TIMEOUT_MS=800
RESIZE_TIMEOUT_MS=5000

CATALOGUE_TTL_SECONDS=3600
SIZING_TTL_SECONDS=604800
PRICING_TTL_SECONDS=86400
STALE_RETENTION_SECONDS=1209600

SIZING_RATE_LIMIT_PER_SECOND=18
PRICING_RATE_LIMIT_PER_SECOND=4.5

RETRY_MAX_RETRIES=2
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=1000

BREAKER_FAILURE_RATE=0.5
BREAKER_MIN_REQUESTS=5
BREAKER_WINDOW_MS=10000
BREAKER_COOLDOWN_MS=5000

MOCK_SIZING_PORT=4001
MOCK_CATALOGUE_PORT=4002
MOCK_PRICING_PORT=4003
MOCK_SIZING_MIN_DELAY_MS=500
MOCK_SIZING_MAX_DELAY_MS=3000
MOCK_SIZING_FAILURE_RATE=0.2
MOCK_PRICING_RATE_LIMIT_PER_SECOND=5
